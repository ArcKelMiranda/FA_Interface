# facodes never connects to SQL Server directly -- it only talks to
# yhat-mcp-server over MCP (Streamable HTTP), container-to-container.

# Sent as the `x-yhat-internal-identity` header on every MCP call, per
# yhat-mcp-server's authorizeInternalMcpRequest gate.
YHAT_INTERNAL_IDENTITY=change-me

# Host yhat-mcp-server's internal gate allowlists, and the hostname facodes
# connects to over HTTP(S) -- see docker-compose.yml for the two real local-
# dev options (point this at a reachable yhat-mcp-server instance, or share
# a manually-created Docker network). Production default matches
# yhat-mcp-server's own Caddy-fronted hostname.
YHAT_INTERNAL_HOST=mcp.internal.yhat

# Optional: full MCP endpoint URL override. Defaults to
# https://${YHAT_INTERNAL_HOST}/mcp (the Caddy-fronted production path). Its
# host must match YHAT_INTERNAL_HOST or be a loopback address -- the client
# refuses to start otherwise (src/mcp/yhat-client.ts Host allowlist).
# Example for local dev against a directly-published yhat-mcp-server:
# YHAT_MCP_URL=http://127.0.0.1:3000/mcp
#YHAT_MCP_URL=

# Kept false until sdd/yhat-mcp-server/pending-write-tools ships (see
# design.md Write-Confirmation Gate and Migration/Rollout).
WRITE_TOOLS_ENABLED=false

PORT=8080
