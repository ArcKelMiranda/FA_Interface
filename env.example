# facodes never connects to SQL Server directly -- it only talks to
# yhat-mcp-server over MCP (Streamable HTTP), container-to-container.

# Sent as the `x-yhat-internal-identity` header on every MCP call, per
# yhat-mcp-server's authorizeInternalMcpRequest gate.
YHAT_INTERNAL_IDENTITY=change-me

# Host yhat-mcp-server's internal gate allowlists (resolves via the shared
# yhat-internal Docker network -- see docker-compose.yml networks note).
YHAT_INTERNAL_HOST=yhat-mcp-server

# Kept false until sdd/yhat-mcp-server/pending-write-tools ships (see
# design.md Write-Confirmation Gate and Migration/Rollout).
WRITE_TOOLS_ENABLED=false

PORT=8080
